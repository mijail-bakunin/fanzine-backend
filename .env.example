NODE_ENV=development
HOST=0.0.0.0
PORT=3001
API_PREFIX=/laguillotina/api/v1
APP_PUBLIC_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POSTGRES_PORT=5432
DATABASE_URL=postgresql://guillotina:guillotina_dev@127.0.0.1:5432/laguillotina?schema=public
LOG_LEVEL=info
TRUST_PROXY=false

# Reemplazar por valores largos y aleatorios fuera de desarrollo.
COOKIE_SECRET=replace-with-at-least-32-random-characters
ANONYMOUS_HMAC_SECRET=replace-with-at-least-32-random-characters
ANALYTICS_HMAC_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=lg_session
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
PASSWORD_RESET_TTL_MINUTES=60

STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
PUBLIC_STORAGE_BASE_URL=http://localhost:3001/laguillotina/api/v1/media
MAX_VIDEO_BYTES=524288000
MAX_DEFAULT_FILE_BYTES=104857600
MULTIPART_THRESHOLD_BYTES=104857600
SIGNED_UPLOAD_TTL_SECONDS=900

# S3, Cloudflare R2 u otro proveedor compatible. Vacío en modo local.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

MAIL_MODE=development
DEV_MAILBOX_PATH=./.dev-mailbox
MODERATION_EMAIL_IMAGE_URL=http://localhost:3001/laguillotina/api/v1/media/seed/comment-moderation-panorama.png
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_CALLBACK_URL=
OAUTH_X_CLIENT_ID=
OAUTH_X_CLIENT_SECRET=
OAUTH_X_CALLBACK_URL=

ANALYTICS_RAW_RETENTION_DAYS=30
CRON_SECRET=replace-with-a-random-cron-secret
